---
import DefaultHead from "@astrojs/starlight/components/Head.astro";

const { entry } = Astro.locals.starlightRoute;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const routeSegments = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, "")
  .split("/")
  .filter(Boolean);
const breadcrumbs = [
  { "@type": "ListItem", position: 1, name: "Verchestra", item: siteUrl.href },
  ...routeSegments.map((segment, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name:
      index === routeSegments.length - 1
        ? entry.data.title
        : segment.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase()),
    item: new URL(`${routeSegments.slice(0, index + 1).join("/")}/`, siteUrl).href
  }))
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs
};
const markdownAlternate = new URL("index.html.md", Astro.url);
const llmsUrl = new URL("llms.txt", siteUrl);
const llmsFullUrl = new URL("llms-full.txt", siteUrl);
---

<DefaultHead />
<link rel="alternate" type="text/markdown" href={markdownAlternate.href} />
<link rel="alternate" type="text/plain" title="Verchestra LLM summary" href={llmsUrl.href} />
<link rel="alternate" type="text/plain" title="Verchestra full LLM context" href={llmsFullUrl.href} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<script>
  let mermaidRenderId = 0;

  // why: the code block is the diagram's text equivalent, and it stays in the
  // page until the SVG exists. Replacing it first showed an empty box while
  // the Mermaid bundle loaded. A theme change re-renders the diagrams already
  // in place; a block still waiting on its first render is left to that render.
  const renderMermaid = async () => {
    const pending = [...document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]')].flatMap((pre) => {
      if (pre.dataset.mermaidPending !== undefined) return [];
      const source = [...pre.querySelectorAll<HTMLElement>(".ec-line .code")]
        .map((line) => line.textContent ?? "")
        .join("\n");
      if (!source) return [];
      pre.dataset.mermaidPending = "";
      const diagram = document.createElement("div");
      diagram.className = "mermaid-diagram";
      diagram.setAttribute("role", "img");
      diagram.setAttribute(
        "aria-label",
        "Architecture diagram. The surrounding document provides the equivalent system description."
      );
      diagram.dataset.mermaidSource = source;
      return [{ frame: pre.closest("figure") ?? pre, diagram }];
    });

    const rendered = [...document.querySelectorAll<HTMLElement>(".mermaid-diagram")];
    if (pending.length === 0 && rendered.length === 0) return;
    const { default: mermaid } = await import("mermaid");
    const isLight = document.documentElement.dataset.theme === "light";
    const palette = isLight
      ? {
          background: "transparent",
          primaryColor: "#FFFFFF",
          primaryTextColor: "#121525",
          primaryBorderColor: "#5B4FD8",
          lineColor: "#087F7A",
          secondaryColor: "#EEEBF6",
          tertiaryColor: "#F7F4ED"
        }
      : {
          background: "transparent",
          primaryColor: "#0E1424",
          primaryTextColor: "#F3EFE6",
          primaryBorderColor: "#8A7CFF",
          lineColor: "#45D6D0",
          secondaryColor: "#18203A",
          tertiaryColor: "#070A12"
        };
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      themeVariables: palette
    });

    const paint = async (diagram: HTMLElement) => {
      const source = diagram.dataset.mermaidSource;
      if (!source) return;
      const id = `verchestra-mermaid-${mermaidRenderId++}`;
      const { svg, bindFunctions } = await mermaid.render(id, source);
      diagram.innerHTML = svg;
      bindFunctions?.(diagram);
    };

    await Promise.all([
      ...rendered.map(paint),
      ...pending.map(async ({ frame, diagram }) => {
        await paint(diagram);
        frame.replaceWith(diagram);
      })
    ]);
  };

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLTableElement>(".sl-markdown-content table").forEach((table) => {
      table.tabIndex = 0;
    });
    void renderMermaid();

    new MutationObserver((mutations) => {
      if (mutations.some(({ attributeName }) => attributeName === "data-theme")) {
        void renderMermaid();
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  });
</script>
