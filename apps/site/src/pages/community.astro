---
import ProductLayout from "../layouts/ProductLayout.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const communityBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Verchestra",
      item: "https://accd.github.io/verchestra/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Community",
      item: "https://accd.github.io/verchestra/community/"
    }
  ]
};
---

<ProductLayout
  title="Community · Verchestra"
  description="Discuss, contribute to, and responsibly report issues in the Verchestra project."
  structuredData={communityBreadcrumbs}
>
  <main id="main-content" class="community-page">
    <section class="community-hero" aria-labelledby="community-page-title">
      <p class="section-label">Open source, evidence first</p>
      <h1 id="community-page-title">Help make AI delivery reviewable.</h1>
      <p>
        Verchestra is GPL-3.0-only and currently in qualification. Challenge the architecture, improve the evidence, or
        help build the verified road to 1.0.
      </p>
    </section>
    <section class="community-grid" aria-label="Community resources">
      <article>
        <h2>Discussions</h2>
        <p>Ask design questions, share use cases, and propose integrations before opening implementation work.</p>
        <a class="text-link" href="https://github.com/accd/verchestra/discussions">Join GitHub Discussions →</a>
      </article>
      <article>
        <h2>Issues</h2>
        <p>Track ready work, qualification stages, documentation, defects, and roadmap dependencies.</p>
        <a class="text-link" href="https://github.com/accd/verchestra/issues">Browse issues →</a>
      </article>
      <article>
        <h2>Contributing</h2>
        <p>Follow the atomic-change, verification, security, and documentation expectations.</p>
        <a class="text-link" href={withBase("docs/community/contributing/")}>Read the guide →</a>
      </article>
      <article>
        <h2>Coding agents</h2>
        <p>Bootstrap from tracked instructions, use portable handoffs, and apply the same evidence standard.</p>
        <a class="text-link" href={withBase("docs/community/contributing-with-agents/")}>Open the agent guide →</a>
      </article>
      <article>
        <h2>Security</h2>
        <p>Report vulnerabilities privately. Do not disclose credentials or exploitable details in public issues.</p>
        <a class="text-link" href={withBase("docs/community/security/")}>Read the security policy →</a>
      </article>
      <article>
        <h2>Support</h2>
        <p>Understand the current qualification boundary and the best channel for each kind of question.</p>
        <a class="text-link" href={withBase("docs/community/support/")}>View support options →</a>
      </article>
      <article>
        <h2>Roadmap</h2>
        <p>Inspect completed foundations and the evidence required before any 1.0 decision.</p>
        <a class="text-link" href={withBase("roadmap/")}>Follow the roadmap →</a>
      </article>
    </section>
  </main>
</ProductLayout>
