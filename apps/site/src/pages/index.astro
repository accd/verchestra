---
import {
  capabilityMatrix,
  maturityDefinitions,
  notToday,
  databases,
  deliveryStages,
  drivers,
  guarantees,
  productDefinition,
  productHeadline,
  productScenario,
  productStatus
} from "../data/product.ts";
import ProductLayout from "../layouts/ProductLayout.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
// Once the declared chain has no next task, what is still ahead is not a task
// but the signed release decision. Its outcome comes from the typed status, so
// a recorded hold reads as the decision it is, never as "pending".
const decisionMade = productStatus.nextTask === null && productStatus.decision === "hold";
const decisionLabel =
  productStatus.nextTask !== null
    ? `${productStatus.nextTask} next`
    : decisionMade
      ? "1.0 decision: signed hold"
      : "1.0 decision pending";
const qualificationHeadline =
  productStatus.nextTask !== null
    ? `${productStatus.nextTask} is work.`
    : decisionMade
      ? "The 1.0 decision is a signed hold."
      : "The signed 1.0 decision is work.";
const qualificationSummary =
  productStatus.nextTask !== null
    ? "Independent acceptance and the explicit 1.0 release decision remain ahead."
    : decisionMade
      ? `The declared qualification chain is fully verified. The signed promote-or-reject decision has been made: a reject, recorded as a hold. The candidate keeps operating as ${productStatus.version}; a promote round would decide on a fresh candidate with its own decision file.`
      : "The declared qualification chain is fully verified. The signed promote-or-reject decision a 1.0 release requires has not been made.";
const progressNextCell = productStatus.nextTask ?? (decisionMade ? "1.0: signed hold" : "1.0 decision");
const progressLabel =
  productStatus.nextTask !== null
    ? `${productStatus.completedTask} complete, ${productStatus.nextTask} next`
    : `${productStatus.completedTask} complete, ${decisionMade ? "1.0 decision a signed hold" : "1.0 decision next"}`;
const sourceCodeMetadata = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Verchestra",
  description: productDefinition,
  codeRepository: "https://github.com/accd/verchestra",
  license: "https://spdx.org/licenses/Apache-2.0.html",
  programmingLanguage: "TypeScript",
  runtimePlatform: "Node.js 24.14.0",
  version: productStatus.version,
  url: "https://accd.github.io/verchestra/",
  subjectOf: [
    {
      "@type": "DigitalDocument",
      name: "Verchestra LLM documentation summary",
      encodingFormat: "text/plain",
      url: "https://accd.github.io/verchestra/llms.txt"
    },
    {
      "@type": "DigitalDocument",
      name: "Verchestra full LLM context",
      encodingFormat: "text/plain",
      url: "https://accd.github.io/verchestra/llms-full.txt"
    }
  ]
};
---

<ProductLayout
  title="Verchestra — Verified AI software delivery"
  description="AI delivery that survives the model, the machine, and the handoff."
  structuredData={sourceCodeMetadata}
>
  <main id="main-content" class="product-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow">
          <span></span> Verified delivery
        </p>
        <h1 id="hero-title">{productHeadline}</h1>
        <p class="hero__definition">{productDefinition}</p>
        <p class="hero__scenario">
          <strong>In practice:</strong> {productScenario}
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href={withBase("docs/install-and-run/")}>
            Install the beta build
          </a>
          <a class="button button--secondary" href="https://github.com/accd/verchestra">
            View on GitHub
          </a>
          <a class="text-link" href={withBase("roadmap/")}>
            Follow the road to 1.0 <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="qualification-pill" aria-label="Current public status">
          <span class="qualification-pill__signal"></span>
          <code>{productStatus.version}</code>
          <span>{productStatus.completedTask} verified</span>
          <span>{decisionLabel}</span>
        </div>
        <p class="status-note">
          Public source development and a published qualification package are available. A production release is not.
        </p>
      </div>

      <div class="execution-score" aria-label="Portable delivery workflow diagram">
        <div class="execution-score__head">
          <span>Delivery path</span>
          <code>portable / signed / reviewable</code>
        </div>
        <ol>
          {deliveryStages.map((stage, index) => (
            <li>
              <span class="execution-score__number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <strong>{stage.name}</strong>
                <span>{stage.description}</span>
              </div>
            </li>
          ))}
        </ol>
        <div class="execution-score__seal">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Human accountable</strong>
            <small>Evidence before acceptance</small>
          </div>
        </div>
      </div>
    </section>

    <section class="problem statement-grid" aria-labelledby="problem-title">
      <div>
        <p class="section-label">The problem</p>
        <h2 id="problem-title">A chat is not a delivery system.</h2>
      </div>
      <div class="statement">
        <p>
          AI-assisted work disappears into provider sessions, local machines, and undocumented decisions. The next
          developer inherits a conversation, not an executable contract.
        </p>
        <p>
          Verchestra makes the durable facts portable while credentials, sessions, and machine authority remain local.
        </p>
      </div>
    </section>

    <section class="works-today section-frame" aria-labelledby="works-today-title">
      <div class="section-heading">
        <p class="section-label">What works today</p>
        <h2 id="works-today-title">One honest matrix, straight from the evidence.</h2>
        <p>
          Human-readable status first, internal task ids second. Each state has one meaning:
          <strong>available</strong> — {maturityDefinitions.available.toLowerCase()}
          <strong> qualified</strong> — {maturityDefinitions.qualified.toLowerCase()}
          <strong> planned</strong> — {maturityDefinitions.planned.toLowerCase()}
        </p>
      </div>
      <div class="works-today__table-wrap">
        <table class="works-today__table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Status</th>
              <th scope="col">Evidence</th>
            </tr>
          </thead>
          <tbody>
            {capabilityMatrix.map((entry) => (
              <tr>
                <th scope="row">{entry.capability}</th>
                <td>
                  <span class={`works-today__state works-today__state--${entry.maturity}`}>{entry.maturity}</span>
                </td>
                <td>
                  <a href={withBase(`${entry.evidenceRoute}/`)}>{entry.reference}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="guarantees section-frame" aria-labelledby="guarantees-title">
      <div class="section-heading">
        <h2 id="guarantees-title">Control where it matters. Freedom where it helps.</h2>
        <p>Models can change. The delivery contract, evidence, and accountability do not.</p>
      </div>
      <div class="guarantee-grid">
        {guarantees.map((guarantee, index) => (
          <article class={`guarantee-card guarantee-card--${guarantee.tone}`}>
            <span class="guarantee-card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{guarantee.title}</h3>
            <p>{guarantee.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="handoff section-frame" aria-labelledby="handoff-title">
      <div class="section-heading">
        <h2 id="handoff-title">Start with one environment. Continue with another.</h2>
        <p>
          <strong>Example handoff.</strong> The receiving developer rebuilds local authority while preserving the signed
          execution contract.
        </p>
      </div>
      <div
        class="handoff-path"
        role="img"
        aria-label="Claude Code hands a signed execution package to OpenCode and Qwen"
      >
        <div class="handoff-node">
          <small>Source environment</small>
          <strong>Claude Code</strong>
          <span>Discovery · specification</span>
        </div>
        <div class="handoff-bridge">
          <span class="handoff-bridge__line"></span>
          <div>
            <span aria-hidden="true">◆</span>
            <strong>Signed Execution Package</strong>
            <small>requirements · evidence · gates</small>
          </div>
        </div>
        <div class="handoff-node handoff-node--target">
          <small>Receiving environment</small>
          <strong>OpenCode / Qwen</strong>
          <span>Local authority · same contract</span>
        </div>
      </div>
      <ul class="driver-list" aria-label="Qualified AI drivers">
        {drivers.map((driver) => (
          <li>{driver}</li>
        ))}
      </ul>
    </section>

    <section class="probes section-frame" aria-labelledby="probes-title">
      <div class="probes__copy">
        <p class="section-label">Read-only data probes</p>
        <h2 id="probes-title">Context from real systems. No hidden writer.</h2>
        <p>
          Database discovery runs through bounded plans, explicit capabilities, audit evidence, and read-only
          credentials. SQLite is live-qualified in this repository; the other six engines are contract-verified here and
          qualified at the edge.
        </p>
        <a class="text-link" href={withBase("docs/workflows/read-only-database-discovery/")}>
          Explore database discovery <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="database-panel">
        <div class="database-panel__header">
          <span>Approved probe surface</span>
          <code>mode: read_only</code>
        </div>
        <ul>
          {databases.map((database, index) => (
            <li class={index === 0 ? "database-panel__primary" : undefined}>
              <span class="database-panel__status" aria-hidden="true" />
              <strong>{database}</strong>
              <small>{index === 0 ? "live-qualified" : "contract-verified"}</small>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="architecture section-frame" aria-labelledby="architecture-title">
      <div class="section-heading">
        <h2 id="architecture-title">A delivery control plane, not a model wrapper.</h2>
      </div>
      <div class="architecture-map">
        <div class="architecture-map__core">
          <span>vestra CLI</span>
          <strong>Application workflows</strong>
          <small>Policy-bound orchestration</small>
        </div>
        <div class="architecture-map__satellites">
          <span>Workspace</span>
          <span>Drivers</span>
          <span>Probes</span>
          <span>Memory</span>
          <span>Evidence</span>
          <span>Distribution</span>
        </div>
      </div>
      <a class="button button--secondary" href={withBase("docs/architecture/system-overview/")}>
        Read the architecture
      </a>
    </section>

    <section class="qualification section-frame" aria-labelledby="qualification-title">
      <div>
        <h2 id="qualification-title">
          {productStatus.completedTask} is evidence. {qualificationHeadline}
        </h2>
        <p>
          Foundations through {productStatus.completedTask} are backed by public validation reports.{" "}
          {qualificationSummary}
        </p>
      </div>
      <div class="qualification-progress" aria-label={progressLabel}>
        <div class="qualification-progress__complete">
          <span>T01</span>
          <span>{productStatus.completedTask}</span>
        </div>
        <div class="qualification-progress__next">{progressNextCell}</div>
        {/* The declared chain ends at T77, so once the derived next task IS
        T77 this cell would repeat it. Rendering it only while T77 is still
        ahead keeps the strip honest instead of showing one milestone twice.
        Once T77 itself is verified there is no chain task left to show, and the
        next cell is the release decision, which is not a chain task. */}
        {productStatus.nextTask !== null && productStatus.nextTask !== "T77" && (
          <div class="qualification-progress__future">T77</div>
        )}
      </div>
      <div class="qualification__actions">
        <a class="button button--primary" href={withBase("roadmap/")}>
          View the verified roadmap
        </a>
        <a
          class="text-link"
          href={withBase(`docs/qualification/${productStatus.completedTask.toLowerCase()}-validation/`)}
        >
          Inspect {productStatus.completedTask} evidence →
        </a>
      </div>
    </section>

    <section class="not-today section-frame" aria-labelledby="not-today-title">
      <div class="section-heading">
        <p class="section-label">What Verchestra is not</p>
        <h2 id="not-today-title">Ruled out, in the present tense.</h2>
      </div>
      <ul class="not-today__list">
        {notToday.map((statement) => (
          <li>{statement}</li>
        ))}
      </ul>
    </section>

    <section class="community-cta" aria-labelledby="community-title">
      <p class="section-label">Build the standard with us</p>
      <h2 id="community-title">AI delivery deserves better evidence.</h2>
      <p>Explore the architecture, challenge the design, and help qualify the path to 1.0.</p>
      <div>
        <a class="button button--primary" href="https://github.com/accd/verchestra/discussions">
          Join the discussion
        </a>
        <a class="button button--secondary" href={withBase("docs/community/contributing/")}>
          Contribute
        </a>
      </div>
    </section>
  </main>
</ProductLayout>
