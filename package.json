{
  "name": "verchestra",
  "version": "0.0.0-qualification",
  "private": true,
  "description": "Verchestra verified AI software-delivery harness",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json eslint.config.mjs .prettierrc.json scripts tests apps packages",
    "lint": "eslint eslint.config.mjs scripts tests apps packages",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "agent:context": "node scripts/agent-context.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "agent:eval": "node scripts/agent-eval.mjs",
    "test:agent-readiness": "node --test tests/agent-readiness/*.test.mjs tests/architecture/agent-instructions.test.mjs",
    "test:unit": "node scripts/test-scope.mjs unit tests/unit",
    "test:contract": "node scripts/test-scope.mjs contract tests/contract",
    "test:integration": "node scripts/test-scope.mjs integration tests/integration",
    "test:e2e": "node scripts/test-scope.mjs e2e tests/e2e",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:qualification": "node --test spikes/node-runtime/test/*.test.mjs spikes/pi-runtime/test/*.test.mjs spikes/claude-code-driver/test/*.test.mjs spikes/codex-driver/test/*.test.mjs spikes/opencode-driver/test/*.test.mjs spikes/cedar/test/*.test.mjs spikes/sqlite/test/*.test.mjs spikes/isolation/test/*.test.mjs spikes/supply-chain/test/*.test.mjs",
    "test:security": "node scripts/test-scope.mjs security tests/security",
    "test:fault": "node scripts/test-scope.mjs fault tests/fault-injection",
    "test:release": "node scripts/test-scope.mjs release tests/public-regression tests/system",
    "gate:quick": "node scripts/gate.mjs quick",
    "gate:full": "node scripts/gate.mjs full",
    "gate:build": "node scripts/gate.mjs build",
    "gate:security": "node scripts/gate.mjs security",
    "gate:release": "node scripts/gate.mjs release",
    "qualify:node": "node --test spikes/node-runtime/test/*.test.mjs",
    "qualify:pi": "node --test spikes/pi-runtime/test/*.test.mjs",
    "qualify:claude": "node --test spikes/claude-code-driver/test/*.test.mjs",
    "qualify:codex": "node --test spikes/codex-driver/test/*.test.mjs",
    "qualify:opencode": "node --test spikes/opencode-driver/test/*.test.mjs",
    "qualify:cedar": "node --test spikes/cedar/test/*.test.mjs",
    "qualify:sqlite": "node --test spikes/sqlite/test/*.test.mjs",
    "qualify:isolation": "node --test spikes/isolation/test/*.test.mjs",
    "qualify:supply-chain": "node --test spikes/supply-chain/test/*.test.mjs",
    "site:dev": "pnpm --filter @verchestra/site dev",
    "site:check": "pnpm --filter @verchestra/site check",
    "site:build": "pnpm --filter @verchestra/site build",
    "site:test": "pnpm --filter @verchestra/site test",
    "site:test:e2e": "pnpm --filter @verchestra/site test:e2e",
    "site:preview": "pnpm --filter @verchestra/site preview"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "4.11.2",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@opencode-ai/sdk": "1.17.18",
    "@tufjs/canonical-json": "2.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "jose": "6.2.3",
    "json-schema-to-typescript": "15.0.4",
    "opencode-ai": "1.17.18",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "sqlite-vec": "0.1.9",
    "tuf-js": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
