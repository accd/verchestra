{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ves://promotion-report/1",
  "title": "PromotionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "candidateDigest",
    "holdoutDigest",
    "policyId",
    "evaluatorKeyId",
    "evidenceDigest",
    "blocks",
    "bodyDigest"
  ],
  "properties": {
    "verdict": { "enum": ["PROMOTED", "BLOCKED"] },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "holdoutDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "evaluatorKeyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "blocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "VES_PROMOTION_ORACLE_TAMPERED",
          "VES_PROMOTION_CANDIDATE_MUTATED",
          "VES_PROMOTION_SHARED_IDENTITY",
          "VES_PROMOTION_CONTAMINATED",
          "VES_PROMOTION_INSUFFICIENT_REPETITION",
          "VES_PROMOTION_CAMPAIGN_FAILED"
        ]
      }
    },
    "bodyDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
