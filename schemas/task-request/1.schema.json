{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ves://task-request/1",
  "title": "TaskRequest",
  "description": "Untrusted user request for one governed delivery task. Identity, digests, executables, credentials and approvals are derived locally and never carried here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "task", "gates", "budgets", "driver", "verifier", "instructions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "requirementIds",
        "dependencyTaskIds",
        "component",
        "changeScope",
        "protectedPaths",
        "verificationCommands",
        "doneCriteria",
        "risk",
        "expectedCommitBoundary"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,511}$"
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VES-[A-Z]{3}-[0-9]{3}$"
          }
        },
        "dependencyTaskIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,511}$"
          }
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,511}$"
        },
        "changeScope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+$"
          }
        },
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+$"
          }
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e]{1,512}$"
          }
        },
        "doneCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e]{1,512}$"
          }
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "expectedCommitBoundary": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e]{1,512}$"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "requirementIds",
          "declaredCommand",
          "commandRef",
          "args",
          "cwd",
          "timeoutMs",
          "outputLimitBytes",
          "resultProtocol",
          "minimumTests"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,511}$"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VES-[A-Z]{3}-[0-9]{3}$"
            }
          },
          "declaredCommand": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e]{1,512}$"
          },
          "commandRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,511}$"
          },
          "args": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*=[\\\\/])(?!.*=[A-Za-z]:)(?!.*(?:^|[\\\\/=])\\.\\.(?:[\\\\/]|$))[\\x20-\\x7e]{1,512}$"
            }
          },
          "cwd": {
            "type": "string",
            "pattern": "^(?:\\.|(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+)$"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "outputLimitBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16000000
          },
          "resultProtocol": {
            "type": "string",
            "enum": ["exit-code", "test-summary"]
          },
          "minimumTests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumCostUsd", "maximumTokens", "maximumDurationMs"],
      "properties": {
        "maximumCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "maximumTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maximumDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "onGateFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "feedbackToDriver", "escalateAfter"],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "feedbackToDriver": {
          "type": "boolean"
        },
        "escalateAfter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driverId", "model"],
      "properties": {
        "driverId": {
          "type": "string",
          "const": "claude-code"
        },
        "model": {
          "type": "string",
          "pattern": "^claude-[a-z0-9][a-z0-9.-]{0,63}$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driverId", "model"],
      "properties": {
        "driverId": {
          "type": "string",
          "const": "codex"
        },
        "model": {
          "type": "string",
          "pattern": "^gpt-[a-z0-9][a-z0-9.-]{0,63}$"
        }
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]+$"
    }
  }
}
